  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ryanradtke03/orca/issues"
  },
  "homepage": "https://github.com/ryanradtke03/orca#readme",
  "private": true,
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "electron": "44.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
