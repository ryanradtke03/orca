{
  "name": "orca",
  "version": "1.0.0",
  "description": "Electron desktop app for orchestrating multiple Claude Code CLI sessions",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:demo": "ORCA_DEMO=1 electron-vite dev",
